# ==========================================================
# KONFIGURASI PRODUKSI: DINGXIN MULTI DISTRIBUSI
# Salin file ini ke .env di server cPanel produksi (dingxin.symotech.web.id)
# ==========================================================

APP_NAME="Dingxin Symotech"
APP_ENV=production
APP_KEY=base64:cpanel_generate_key_here
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://dingxin.symotech.web.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ----------------------------------------------------------
# KONFIGURASI DATABASE MySQL cPanel
# ----------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=symotec3_dingxin
DB_USERNAME=symotec3_dingxinuser
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_CPANEL
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ----------------------------------------------------------
# DRIVER SESSION, CACHE & STORAGE
# ----------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# ----------------------------------------------------------
# LOGGING PRODUKSI
# ----------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAYS=14

# ----------------------------------------------------------
# EMAIL & NOTIFIKASI
# ----------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@symotech.web.id"
MAIL_FROM_NAME="${APP_NAME}"
